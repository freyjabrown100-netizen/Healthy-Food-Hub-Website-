6. Functions & Triggers
6. Functions & Triggers
Trigger: on_auth_user_created → handle_new_user()
Jab naya user Supabase Auth se register kare, automatically profiles table mein row create ho:
CREATE OR REPLACE FUNCTION handle_new_user()
RETURNS trigger AS 

BEGIN
INSERT INTO public.profiles (id, email, full_name, role)
VALUES (
NEW.id,
NEW.email,
NEW.raw_user_meta_data->>'full_name',
'user'
);
RETURN NEW;
END;
 LANGUAGE plpgsql SECURITY DEFINER;
CREATE TRIGGER on_auth_user_created
AFTER INSERT ON auth.users
FOR EACH ROW EXECUTE FUNCTION handle_new_user();
Function: get_recipe_avg_rating(recipe_id uuid)
Recipe ka average rating calculate kare (used in recipe cards):
CREATE OR REPLACE FUNCTION get_recipe_avg_rating(p_recipe_id uuid)
RETURNS numeric AS 

SELECT ROUND(AVG(rating)::numeric, 1)
FROM reviews
WHERE recipe_id = p_recipe_id;
 LANGUAGE sql STABLE;
Trigger: update_updated_at (on recipes, profiles, blog_posts)
Automatically updated_at timestamp update kare:
CREATE OR REPLACE FUNCTION set_updated_at()
RETURNS trigger AS 

BEGIN
NEW.updated_at = now();
RETURN NEW;
END;
 LANGUAGE plpgsql;
-- Apply to recipes, profiles, blog_posts tables
CREATE TRIGGER set_recipes_updated_at
BEFORE UPDATE ON recipes
FOR EACH ROW EXECUTE FUNCTION set_updated_at();
Function: generate_slug(title text)
Title se URL-friendly slug generate kare:
CREATE OR REPLACE FUNCTION generate_slug(title text)
RETURNS text AS 

SELECT lower(regexp_replace(
regexp_replace(title, '[^a-zA-Z0-9\s]', '', 'g'),
'\s+', '-', 'g'
));
 LANGUAGE sql IMMUTABLE;
